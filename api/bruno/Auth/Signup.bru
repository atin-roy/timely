meta {
  name: Signup
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "username": "atin",
    "email": "{{email}}",
    "password": "{{password}}",
    "timezone": "{{timezone}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("token", res.body.token);
  }
}
