meta {
  name: Update Me
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/users/me
  body: json
  auth: inherit
}

body:json {
  {
    "timezone": "{{timezone}}",
    "pomodoroSettings": {
      "focusMinutes": 25,
      "shortBreakMinutes": 5,
      "longBreakMinutes": 15,
      "pomodorosPerLongBreak": 4
    }
  }
}
