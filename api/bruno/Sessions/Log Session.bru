meta {
  name: Log Session
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/sessions
  body: json
  auth: inherit
}

body:json {
  {
    "kind": "focus",
    "activityId": {{activityId}},
    "timezone": "{{timezone}}",
    "startedAt": "2026-10-20T09:00:00+05:30",
    "endedAt": "2026-10-20T10:30:00+05:30"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("sessionId", res.body.id);
  }
}

docs {
  For a break, set `kind` to `break` and remove `activityId`. Fails with `session-overlap` if the time is already taken.
}
