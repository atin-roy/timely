meta {
  name: Start Cycle
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/pomodoro/cycles
  body: json
  auth: inherit
}

body:json {
  {
    "activityId": {{activityId}},
    "timezone": "{{timezone}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("cycleId", res.body.id);
    bru.setVar("sessionId", res.body.currentSession.id);
  }
}
